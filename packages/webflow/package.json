{
  "name": "@shadermix/webflow",
  "version": "0.0.0",
  "description": "CDN bundle of Shadermix effects for Webflow sites.",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "dependencies": {
    "@shadermix/core": "workspace:*"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.0.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "size-limit": [
    {
      "path": "dist/shadermix.min.js",
      "limit": "25 KB"
    }
  ]
}
