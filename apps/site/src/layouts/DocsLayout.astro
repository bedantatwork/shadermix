---
import { getDocPages } from "../lib/docs-content";
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
}

const { title, description, activeSlug } = Astro.props;
const docs = getDocPages();

const groups = [
  { heading: "Get started", slugs: ["introduction"] },
  {
    heading: "Installation",
    slugs: ["installation/astro", "installation/webflow", "installation/vanilla"],
  },
  { heading: "Guides", slugs: ["performance"] },
];
---

<Layout title={title} {...(description ? { description } : {})}>
  <div class="docs">
    <aside class="docs__sidebar">
      <nav aria-label="Documentation">
        {
          groups.map((group) => (
            <div class="docs__group">
              <p class="docs__heading">{group.heading}</p>
              {group.slugs.map((slug) => {
                const doc = docs.find((d) => d.slug === slug);
                // "introduction" lives at /docs itself, not /docs/introduction,
                // so the same content isn't served from two URLs.
                const href = slug === "introduction" ? "/docs" : `/docs/${slug}`;
                return doc ? (
                  <a
                    href={href}
                    class:list={["docs__link", { "docs__link--active": doc.slug === activeSlug }]}
                  >
                    {doc.title}
                  </a>
                ) : null;
              })}
            </div>
          ))
        }
        <div class="docs__group">
          <p class="docs__heading">Reference</p>
          <a class="docs__link" href="/components">Components</a>
          <a class="docs__link" href="/changelog">Changelog</a>
        </div>
      </nav>
    </aside>

    <main class="docs__main">
      <slot />
    </main>
  </div>
</Layout>

<style>
  .docs {
    display: grid;
    grid-template-columns: var(--sm-sidebar-width) minmax(0, 1fr);
    gap: var(--sm-space-5);
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--sm-space-4);
  }

  @media (max-width: 860px) {
    .docs {
      grid-template-columns: 1fr;
    }
    .docs__sidebar {
      position: static;
    }
  }

  .docs__sidebar {
    align-self: start;
    position: sticky;
    top: calc(var(--sm-topbar-height) + var(--sm-space-4));
    display: flex;
    flex-direction: column;
    gap: var(--sm-space-4);
  }

  .docs__group {
    display: flex;
    flex-direction: column;
    gap: var(--sm-space-1);
  }

  .docs__heading {
    font-size: var(--sm-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sm-color-text-muted);
    margin: 0 0 var(--sm-space-1);
  }

  .docs__link {
    font-size: var(--sm-text-sm);
    text-decoration: none;
    color: var(--sm-color-text-muted);
    padding: var(--sm-space-1) var(--sm-space-2);
    border-radius: var(--sm-radius-sm);
  }

  .docs__link:hover {
    color: var(--sm-color-text);
    background: var(--sm-color-card);
  }

  .docs__link--active {
    color: var(--sm-color-text);
    background: var(--sm-color-card);
    box-shadow: inset 2px 0 0 var(--sm-color-accent);
  }

  .docs__main {
    min-width: 0;
  }
</style>
