---
import PortableText from "../components/PortableText.astro";
import Layout from "../layouts/Layout.astro";
import { getChangelogEntries } from "../lib/changelog-content";

const entries = getChangelogEntries();

const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout title="Changelog — Shadermix" description="What's new in Shadermix.">
  <main class="changelog">
    <h1>Changelog</h1>
    <p class="lead">Notable releases. Per-package changelogs live in the repository.</p>

    {
      entries.map((entry) => (
        <article class="entry">
          <header class="entry__head">
            <span class="entry__version">{entry.version}</span>
            <time datetime={entry.date}>{dateFormatter.format(new Date(entry.date))}</time>
          </header>
          <h2>{entry.title}</h2>
          <PortableText value={entry.body} />
        </article>
      ))
    }
  </main>
</Layout>

<style>
  .changelog {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--sm-space-4);
  }

  h1 {
    font-size: var(--sm-text-xl);
    margin: 0 0 var(--sm-space-2);
  }

  .lead {
    color: var(--sm-color-text-muted);
    margin: 0 0 var(--sm-space-5);
  }

  .entry {
    padding-top: var(--sm-space-4);
    border-top: 1px solid var(--sm-color-border);
    margin-bottom: var(--sm-space-5);
  }

  .entry__head {
    display: flex;
    align-items: center;
    gap: var(--sm-space-3);
    font-size: var(--sm-text-sm);
    color: var(--sm-color-text-muted);
  }

  .entry__version {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--sm-color-accent);
    border: 1px solid var(--sm-color-border);
    border-radius: var(--sm-radius-sm);
    padding: 0 var(--sm-space-2);
  }

  .entry h2 {
    font-size: var(--sm-text-lg);
    margin: var(--sm-space-2) 0 var(--sm-space-3);
  }
</style>
