---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Shadermix — Shaders and motion for Astro & Webflow"
  description="An open-source library of animated shader backgrounds, visual effects and text animations for Astro and Webflow."
>
  <main class="home-placeholder">
    <h1>Shadermix</h1>
    <p>Shaders and motion for Astro &amp; Webflow.</p>
    <p class="home-placeholder__note">
      Home page design is pending the Figma reference (plan §8.10) — <a href="/components"
        >see the component gallery</a
      > in the meantime.
    </p>
  </main>
</Layout>

<style>
  .home-placeholder {
    max-width: 640px;
    margin: var(--sm-space-6) auto;
    padding: 0 var(--sm-space-4);
    text-align: center;
  }

  .home-placeholder h1 {
    font-size: var(--sm-text-2xl);
  }

  .home-placeholder__note {
    color: var(--sm-color-text-muted);
    font-size: var(--sm-text-sm);
  }
</style>
