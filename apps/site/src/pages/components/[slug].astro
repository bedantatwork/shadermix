---
import { Code } from "astro:components";
import { Aurora, GrainGradient, MeshGradient } from "@shadermix/astro";
import Layout from "../../layouts/Layout.astro";
import { getComponentBySlug, getComponents, type SchemaFieldLike } from "../../lib/components-content";
import { readEffectSource } from "../../lib/effect-source";

export function getStaticPaths() {
  return getComponents().map((component) => ({ params: { slug: component.slug } }));
}

const { slug } = Astro.params as { slug: string };
const component = getComponentBySlug(slug);
if (!component) {
  throw new Error(`No component doc found for slug "${slug}" — check lib/components-content.ts`);
}

const previewComponents = {
  aurora: Aurora,
  "mesh-gradient": MeshGradient,
  "grain-gradient": GrainGradient,
} as const;
const Preview = previewComponents[component.slug as keyof typeof previewComponents];

function toPascalCase(value: string): string {
  return value
    .split("-")
    .map((part) => part[0]?.toUpperCase() + part.slice(1))
    .join("");
}

const componentName = toPascalCase(component.slug);
const defaultProps = Object.fromEntries(
  Object.entries(component.schema).map(([key, field]) => [key, field.default]),
);

function formatPropsForJsx(props: Record<string, unknown>): string {
  return Object.entries(props)
    .map(([key, value]) => `${key}={${JSON.stringify(value)}}`)
    .join(" ");
}

function toKebabAttr(key: string): string {
  return `sm-${key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}`;
}

function formatAttrsForHtml(props: Record<string, unknown>): string {
  return Object.entries(props)
    .map(([key, value]) => {
      const attrValue = Array.isArray(value) ? value.join(", ") : String(value);
      return `${toKebabAttr(key)}="${attrValue}"`;
    })
    .join(" ");
}

const astroSnippet = `---
import { ${componentName} } from '@shadermix/astro';
---
<${componentName} ${formatPropsForJsx(defaultProps)} />`;

const webflowSnippet = `<div sm-effect="${component.slug}" ${formatAttrsForHtml(defaultProps)}></div>`;

const vanillaSnippet = `import { create${componentName} } from '@shadermix/core/${component.slug}';

const effect = create${componentName}(document.querySelector('#canvas'), ${JSON.stringify(defaultProps, null, 2)});`;

const { shader, factory } = readEffectSource(component.slug);

function formatFieldType(field: SchemaFieldLike): string {
  if (field.type === "number" && field.min !== undefined) return `number (${field.min}–${field.max})`;
  if (field.type === "colors") return `colors[${field.count ?? ""}]`;
  if (field.type === "enum") return `enum (${(field.options ?? []).join(" | ")})`;
  return field.type;
}

const otherComponents = getComponents().filter((c) => c.slug !== component.slug);
---

<Layout title={`${component.title} — Shadermix`} description={component.shortDescription}>
  <article class="detail">
    <nav class="detail__breadcrumb">
      <a href="/components">Components</a> / <span>{component.title}</span>
    </nav>

    <h1>{component.title}</h1>
    <p class="detail__description">{component.shortDescription}</p>

    <div class="detail__preview">
      <Preview {...defaultProps} style="position:absolute;inset:0;" />
    </div>

    <section class="detail__section">
      <h2>Props</h2>
      <table class="props-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Type</th>
            <th>Default</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {
            Object.entries(component.schema).map(([key, field]) => (
              <tr>
                <td>
                  <code>{key}</code>
                </td>
                <td>{formatFieldType(field)}</td>
                <td>
                  <code>{JSON.stringify(field.default)}</code>
                </td>
                <td>{field.description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="detail__section">
      <h2>Usage</h2>
      <div class="tabs">
        <input type="radio" name="snippet-tab" id="tab-astro" class="tabs__radio" checked />
        <label for="tab-astro" class="tabs__label">Astro</label>
        <input type="radio" name="snippet-tab" id="tab-webflow" class="tabs__radio" />
        <label for="tab-webflow" class="tabs__label">Webflow</label>
        <input type="radio" name="snippet-tab" id="tab-vanilla" class="tabs__radio" />
        <label for="tab-vanilla" class="tabs__label">Vanilla</label>
        <input type="radio" name="snippet-tab" id="tab-source" class="tabs__radio" />
        <label for="tab-source" class="tabs__label">Source</label>

        <div class="tabs__panel" data-panel="astro">
          <Code code={astroSnippet} lang="astro" theme="github-dark" />
        </div>
        <div class="tabs__panel" data-panel="webflow">
          <p class="tabs__note">
            Add the CDN script once (see <a href="/docs/installation/webflow">Webflow install docs</a>),
            then add this attribute set to any Div Block or Section.
          </p>
          <Code code={webflowSnippet} lang="html" theme="github-dark" />
        </div>
        <div class="tabs__panel" data-panel="vanilla">
          <Code code={vanillaSnippet} lang="js" theme="github-dark" />
        </div>
        <div class="tabs__panel" data-panel="source">
          <p class="tabs__note">Original shader + factory source — copy and own it, React-Bits-style.</p>
          <Code code={shader} lang="glsl" theme="github-dark" />
          <Code code={factory} lang="ts" theme="github-dark" />
        </div>
      </div>
    </section>

    {
      otherComponents.length > 0 && (
        <section class="detail__section">
          <h2>More effects</h2>
          <div class="related-grid">
            {otherComponents.map((other) => (
              <a class="related-card" href={`/components/${other.slug}`}>
                {other.title}
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .detail {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--sm-space-4);
  }

  .detail__breadcrumb {
    font-size: var(--sm-text-sm);
    color: var(--sm-color-text-muted);
    margin-bottom: var(--sm-space-3);
  }

  .detail__breadcrumb a {
    text-decoration: none;
    color: inherit;
  }

  .detail h1 {
    margin: 0 0 var(--sm-space-2);
    font-size: var(--sm-text-xl);
  }

  .detail__description {
    color: var(--sm-color-text-muted);
    margin: 0 0 var(--sm-space-4);
  }

  .detail__preview {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--sm-color-border);
    border-radius: var(--sm-radius-lg);
    overflow: hidden;
    margin-bottom: var(--sm-space-5);
  }

  .detail__section {
    margin-bottom: var(--sm-space-5);
  }

  .detail__section h2 {
    font-size: var(--sm-text-lg);
    margin-bottom: var(--sm-space-3);
  }

  .props-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sm-text-sm);
  }

  .props-table th,
  .props-table td {
    text-align: left;
    padding: var(--sm-space-2) var(--sm-space-3);
    border-bottom: 1px solid var(--sm-color-border);
  }

  .props-table th {
    color: var(--sm-color-text-muted);
    font-weight: 500;
  }

  .tabs {
    border: 1px solid var(--sm-color-border);
    border-radius: var(--sm-radius-md);
    overflow: hidden;
  }

  .tabs__radio {
    display: none;
  }

  .tabs__label {
    display: inline-block;
    cursor: pointer;
    font-size: var(--sm-text-sm);
    color: var(--sm-color-text-muted);
    padding: var(--sm-space-2) var(--sm-space-3);
    border-bottom: 2px solid transparent;
  }

  .tabs__radio:checked + .tabs__label {
    color: var(--sm-color-text);
    border-bottom-color: var(--sm-color-accent);
  }

  .tabs__panel {
    display: none;
    padding: var(--sm-space-3);
    border-top: 1px solid var(--sm-color-border);
  }

  .tabs__note {
    font-size: var(--sm-text-sm);
    color: var(--sm-color-text-muted);
    margin: 0 0 var(--sm-space-2);
  }

  #tab-astro:checked ~ [data-panel="astro"],
  #tab-webflow:checked ~ [data-panel="webflow"],
  #tab-vanilla:checked ~ [data-panel="vanilla"],
  #tab-source:checked ~ [data-panel="source"] {
    display: block;
  }

  .related-grid {
    display: flex;
    gap: var(--sm-space-3);
    flex-wrap: wrap;
  }

  .related-card {
    text-decoration: none;
    color: var(--sm-color-text);
    border: 1px solid var(--sm-color-border);
    border-radius: var(--sm-radius-sm);
    padding: var(--sm-space-2) var(--sm-space-3);
    font-size: var(--sm-text-sm);
  }

  .related-card:hover {
    border-color: var(--sm-color-text-muted);
  }
</style>
